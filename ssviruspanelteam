--==================================================
-- RGB / SPINNER SYSTEM
--==================================================

local rgbObjects = {}
local spinners = {}
local hue = 0

local function addRGB(object, property)
	if not object then
		return
	end

	table.insert(rgbObjects, {
		obj = object,
		prop = property or "TextColor3",
	})
end

local function addSpinner(object, speed)
	if not object then
		return
	end

	table.insert(spinners, {
		obj = object,
		speed = speed or 90,
	})
end

local heartbeatConnection

heartbeatConnection = RunService.Heartbeat:Connect(function(deltaTime)
	hue = (hue + deltaTime * 0.25) % 1

	local color = Color3.fromHSV(hue, 0.85, 1)

	for i = #rgbObjects, 1, -1 do
		local item = rgbObjects[i]

		if item.obj and item.obj.Parent then
			pcall(function()
				item.obj[item.prop] = color
			end)
		else
			table.remove(rgbObjects, i)
		end
	end

	for i = #spinners, 1, -1 do
		local item = spinners[i]

		if item.obj and item.obj.Parent then
			item.obj.Rotation =
				(item.obj.Rotation + deltaTime * item.speed) % 360
		else
			table.remove(spinners, i)
		end
	end
end)

gui.Destroying:Connect(function()
	if heartbeatConnection then
		heartbeatConnection:Disconnect()
		heartbeatConnection = nil
	end
end)

