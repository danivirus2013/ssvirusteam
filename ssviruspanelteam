--==================================================
-- OPEN / CLOSE STATE
--==================================================

local isOpen = true
local isDestroyed = false

local function showPanel()
	if isDestroyed then
		return
	end

	mini.Visible = false
	panel.Visible = true

	panelScale.Scale = 0.85

	tween(
		panelScale,
		0.35,
		{Scale = 1},
		Enum.EasingStyle.Back
	)

	isOpen = true
end

local function hidePanel()
	if isDestroyed then
		return
	end

	isOpen = false

	tween(
		panelScale,
		0.25,
		{Scale = 0},
		Enum.EasingStyle.Back,
		Enum.EasingDirection.In
	)

	task.delay(0.27, function()
		if not isDestroyed and not isOpen then
			panel.Visible = false
		end
	end)
end

minimizeButton.MouseButton1Click:Connect(function()
	panel.Visible = false
	mini.Visible = true
	isOpen = false
end)

mini.MouseButton1Click:Connect(function()
	showPanel()
end)

closeButton.MouseButton1Click:Connect(function()
	if isDestroyed then
		return
	end

	isDestroyed = true

	tween(
		panelScale,
		0.25,
		{Scale = 0},
		Enum.EasingStyle.Back,
		Enum.EasingDirection.In
	)

	task.delay(0.27, function()
		if gui and gui.Parent then
			gui:Destroy()
		end
	end)
end)

