--// One shared loop: RGB text + spinning logos
local rgbObjects = {}
local spinners = {}
local hue = 0
local destroyed = false

local function addRGB(obj, prop)
	table.insert(rgbObjects, { obj = obj, prop = prop or "TextColor3" })
end

local function addSpinner(obj, speed)
	table.insert(spinners, { obj = obj, speed = speed or 90 })
end

local loop = RunService.Heartbeat:Connect(function(dt)
	if destroyed then return end
	hue = (hue + dt * 0.25) % 1
	local color = Color3.fromHSV(hue, 0.85, 1)
	for _, item in ipairs(rgbObjects) do
		if item.obj and item.obj.Parent then
			pcall(function() item.obj[item.prop] = color end)
		end
	end
	for _, s in ipairs(spinners) do
		if s.obj and s.obj.Parent then
			pcall(function()
				s.obj.Rotation = (s.obj.Rotation + dt * s.speed) % 360
			end)
		end
	end
end)

local function cleanupLoop()
	if destroyed then return end
	destroyed = true
	if loop then
		loop:Disconnect()
		loop = nil
	end
	rgbObjects = {}
	spinners = {}
end

