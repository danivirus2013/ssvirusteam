--// Shared loop: RGB effect
local rgbObjects = {}
local hue = 0

local function addRGB(obj, prop)
	table.insert(rgbObjects, { obj = obj, prop = prop or "TextColor3" })
end

local loop = RunService.Heartbeat:Connect(function(dt)
	hue = (hue + dt * 0.18) % 1
	local color = Color3.fromHSV(hue, 0.7, 1)
	for _, item in ipairs(rgbObjects) do
		if item.obj and item.obj.Parent then
			item.obj[item.prop] = color
		end
	end
end)

gui.Destroying:Connect(function()
	loop:Disconnect()
end)

